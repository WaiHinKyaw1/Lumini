rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Core Security Primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Validation Blueprint (Anti-Update-Gap)
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'credits', 'totalGenerated', 'createdAt', 'updatedAt'])
        && data.keys().size() == 6
        && data.id is string
        && data.id.size() <= 128
        && data.id == request.auth.uid
        && (data.email == null || (data.email is string && data.email.size() <= 256))
        && data.credits is number
        && data.credits >= 0
        && data.credits <= 1000000
        && data.totalGenerated is number
        && data.totalGenerated >= 0;
    }

    // 4. Secure Users Collection Matches
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      
      allow create: if isOwner(userId) 
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && (
          // Action: Transaction Update (spending or earning credits)
          incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'totalGenerated', 'updatedAt'])
        );
        
      allow delete: if false; // Accounts cannot be cascade-deleted by client-side commands
    }
  }
}
